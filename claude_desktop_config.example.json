{
  "mcpServers": {
    "docker": {
      "command": "uvx",
      "args": ["--refresh", "--from", "git+https://github.com/drmogie/docker-mcp", "docker-mcp"],
      "env": {
        "DOCKER_MCP_HOSTS_NAME": "192.168.1.150=themedia,192.168.1.140=thedmz,192.168.1.141=thedocker01",
        "DOCKER_MCP_SSH_USER": "theadmin",
        "DOCKER_MCP_SSH_KEY": "C:\\Users\\YOU\\.ssh\\id_ed25519",
        "DOCKER_MCP_STACKS": "/opt/stacks",
        "DOCKER_MCP_THEVAULT_SSH": "YOUR-USER@192.168.1.11",
        "DOCKER_MCP_THEVAULT_SSH_PASSWORD": "PUT-SSH-PASSWORD-HERE",
        "DOCKER_MCP_THEVAULT_SUDO": "true",
        "DOCKER_MCP_THEVAULT_REMOTE_DOCKER": "/usr/local/bin/docker",
        "DOCKER_MCP_THEVAULT_STACKS": "/volume3/docker/dockhand-nas/data/stacks"
      }
    }
  }
}
